// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// USUARIO ADMINIDTRADOR
model User {
  id Int  @id @default(autoincrement())
  usuario String @unique
  password String
}

// TABLA DE ROLES
model Rol {
  id_rol      Int     @id     @default(autoincrement())
  n_rol       String  @unique
  abrev       String
  datellePermisos   DetallePermiso[]
  usuarios          Usuario[]
}

model Permiso {
  id_per            Int     @id     @default(autoincrement())
  n_per             String  @unique
  abreviatura       String?
  datellePermisos    DetallePermiso[]
}

model DetallePermiso {
  id_dper           Int     @id     @default(autoincrement())
  id_rol            Int 
  id_per            Int
  estado            Boolean @default(false)
  permisos  Permiso @relation(fields: [id_per], references: [id_per])
  roles     Rol @relation(fields: [id_rol], references: [id_rol])
}
model Sub_unidad {
  id_subuni Int @id @default(autoincrement())
  n_subuni  String  @unique
  abreviatura     String
  usuarios     Usuario[]
}
model Usuario {
  dni                   String @db.Char(8)
  n_usu                 String 
  estado                Boolean @default(true)
  password              String
  rol_id                Int   
  subunidad_id_subuni   Int   
  @@id([dni, rol_id, subunidad_id_subuni]) // Clave primaria compuesta
  rol       Rol         @relation(fields: [rol_id], references: [id_rol])
  sub_uni   Sub_unidad  @relation(fields: [subunidad_id_subuni], references: [id_subuni])
  proyectos             Project[]
}



model Form {
  idf       Int @id @default(autoincrement())
  nmForm    String  @unique
  estado    Boolean @default(false)
  abre      String?
  Fcreate   DateTime  @default(now())
  Fupdate   DateTime?
  prg       Prg[]
  res       Res[]
}

model Prg {
  idp       Int @id @default(autoincrement())
  nmPrg     String  @unique
  idf       Int
  type      String
  form      Form  @relation(fields: [idf], references: [idf])
  opcmul    OpcMul[]
  opcuni    OpcUni[]
  opcdes    OpcDes[]
  resom     ResOM[]
  resou     ResOU[]
  resod     ResOD[]
  restxt    ResTxt[]
  resfile   ResFile[]
  resdate   ResDate[]
}

model Res {
  idres     Int @id @default(autoincrement())
  idf       Int
  dni       String
  date      DateTime  @default(now())
  form      Form  @relation(fields: [idf], references: [idf])
  resom     ResOM[]
  resou     ResOU[]
  resod     ResOD[]
  restxt    ResTxt[]
  resfile   ResFile[]
  resdate   ResDate[]
  actividad Actividad[]
}

model OpcMul {
  idomul    Int @id @default(autoincrement())
  idp       Int
  txtOpc    String
  prg       Prg   @relation(fields: [idp], references: [idp])
  resom     ResOM[]
}

model OpcUni {
  idoUni    Int   @id   @default(autoincrement())
  idp       Int
  txtOpc    String
  prg       Prg   @relation(fields: [idp], references: [idp])
  resou     ResOU[]
}

model OpcDes {
  idodes    Int   @id   @default(autoincrement())
  idp       Int
  txtOpc    String
  prg       Prg     @relation(fields: [idp], references: [idp])
  resod     ResOD[]
}

model ResOM {
  idresom     Int   @id     @default(autoincrement())
  idres       Int
  idp         Int
  idomul      Int
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
  opcmul      OpcMul  @relation(fields: [idomul], references: [idomul])
}

model ResOU {
  idresou     Int   @id     @default(autoincrement())
  idres       Int
  idp         Int
  idou        Int
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
  opcuni      OpcUni  @relation(fields: [idou], references: [idoUni])
}

model ResOD {
  idresod     Int   @id     @default(autoincrement())
  idres       Int
  idp         Int
  idodes      Int
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
  opcdes      OpcDes  @relation(fields: [idodes], references: [idodes])
}

model ResTxt {
  idrestxt    Int   @id   @default(autoincrement())
  idp         Int
  idres       Int
  resTxt      String?
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
}

model ResFile {
  idresfile   Int   @id   @default(autoincrement())
  idres       Int
  idp         Int
  resFile     String?
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
}

model ResDate {
  idresdate   Int   @id   @default(autoincrement())
  idres       Int
  idp         Int
  resdate     String
  res         Res     @relation(fields: [idres], references: [idres])
  prg         Prg     @relation(fields: [idp], references: [idp])
}

enum EstadoProyecto {
  PENDIENTE
  ARCHIVADO
  ENCURSO
  COMPLETADO
}

model Project {
  idproj                Int     @id   @default(autoincrement())
  plan                  String  
  estado                String
  dni                   String
  id_rol                Int
  subunidad_id_subuni   Int
  usuario               Usuario @relation(fields: [dni, id_rol, subunidad_id_subuni], references: [dni, rol_id, subunidad_id_subuni])  
  actividad             Actividad[]
}

model Actividad {
  idActivi              Int     @id   @default(autoincrement())
  name                  String  @unique
  fInit                 DateTime
  fFin                  DateTime
  estado                String
  idproj                Int
  idres                 Int
  project               Project   @relation(fields: [idproj], references: [idproj])
  res                   Res       @relation(fields: [idres], references: [idres])
}